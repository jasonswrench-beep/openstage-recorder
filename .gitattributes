# Text files are stored with plain line endings in the repository, whatever the
# computer that edits them uses.
* text=auto

# Windows scripts must keep Windows line endings or they can fail to run.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Files that must never be altered or diffed as text.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.wav binary
*.mp3 binary
*.mp4 binary
*.webm binary
*.woff binary
*.woff2 binary
*.pdf binary
*.docx binary
*.zip binary
*.bmp binary
